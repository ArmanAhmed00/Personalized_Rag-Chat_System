# Every Outlawz setting, with its default. Copy this file to .env and uncomment what you change.
#
# Outlawz reads environment variables; it doesn't read .env by itself. Two ways to use it:
#   - Docker Compose reads ../.env automatically (see docker/compose.yaml).
#   - In a shell:  set -a; . ./.env; set +a; outlawz start
#
# A setting set here is locked in the app's Settings page (it shows "Set by an environment
# variable"). Anything you leave commented can be changed in the app instead.
# Never commit your .env: it's in .gitignore. API keys entered in the app are stored on this
# computer only (secrets.json in the data folder), never in the library or in exports.

# ---------------------------------------------------------------- folders and server
# The folder with your documents. Outlawz keeps its own data in a hidden .outlawz folder inside it.
# OUTLAWZ_LIBRARY=~/Documents/Outlawz Library
# Models, exports, backups and Trash. Default: the OS data folder
# (~/Library/Application Support/Outlawz, %APPDATA%\Outlawz, ~/.local/share/outlawz).
# OUTLAWZ_DATA_DIR=
# OUTLAWZ_HOST=127.0.0.1
# OUTLAWZ_PORT=8642
# OUTLAWZ_OPEN_BROWSER=true

# ---------------------------------------------------------------- access
# If set, every API request must carry this token. Needed to use Outlawz from another device
# (put it behind HTTPS too). Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# OUTLAWZ_ACCESS_TOKEN=
# Extra Host names to accept, comma-separated (localhost, 127.0.0.1 and [::1] always work).
# OUTLAWZ_ALLOWED_HOSTS=
# Origins allowed to call the API from another port, comma-separated. Only for the frontend
# dev server, e.g. http://localhost:3000
# OUTLAWZ_DEV_ORIGINS=
# Running in Docker with the port published on the host's loopback only. Detected automatically.
# OUTLAWZ_DOCKER=false

# ---------------------------------------------------------------- library and reading
# OUTLAWZ_MAX_UPLOAD_MB=50
# Seconds between scans of the library folder, and the deepest subfolder level scanned.
# OUTLAWZ_WATCH_INTERVAL=3
# OUTLAWZ_WATCH_DEPTH=8
# Documents read at the same time, and retries after a temporary error.
# OUTLAWZ_WORKERS=1
# OUTLAWZ_RETRIES=3
# CSV rows indexed for search (analysis always uses every row).
# OUTLAWZ_CSV_ROWS=5000
# Passage size rules, in tokens. Changing them reads affected documents again.
# OUTLAWZ_CHUNK_TOKENS=350
# OUTLAWZ_CHUNK_OVERLAP=50
# OUTLAWZ_CHUNK_MIN=40
# Read scanned PDF pages with Tesseract if it's installed: auto or off.
# OUTLAWZ_OCR=auto

# ---------------------------------------------------------------- models
# Search model: fastembed (local, default) or ollama. Changing it reads every document again.
# OUTLAWZ_EMBEDDER=fastembed
# OUTLAWZ_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Reranking: model (a small local cross-encoder), lexical (word overlap) or off.
# OUTLAWZ_RERANKER=model
# OUTLAWZ_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Chat model: ollama, openai (any OpenAI-compatible server: LM Studio, llama.cpp, vLLM, or a
# cloud API) or anthropic. A cloud model sends your questions and the passages used to answer
# them to that provider; the app shows a notice whenever one is selected.
# OUTLAWZ_LLM=ollama
# OUTLAWZ_LLM_MODEL=llama3.1:8b
# OUTLAWZ_OLLAMA_URL=http://127.0.0.1:11434
# OUTLAWZ_OPENAI_URL=http://127.0.0.1:1234/v1
# OUTLAWZ_OPENAI_KEY=
# OUTLAWZ_ANTHROPIC_KEY=
# Seconds before a model call gives up.
# OUTLAWZ_LLM_TIMEOUT=120
# OUTLAWZ_TEMPERATURE=0.1
# OUTLAWZ_MAX_ANSWER_TOKENS=800

# ---------------------------------------------------------------- search
# Candidates from meaning (vector) and exact-word (BM25) search, and how many the reranker sees.
# OUTLAWZ_VECTOR_K=40
# OUTLAWZ_KEYWORD_K=40
# OUTLAWZ_RERANK_K=30
# Passages sent to the model with each question.
# OUTLAWZ_TOP_K=8
# Reciprocal rank fusion: the constant and the weight of each list.
# OUTLAWZ_RRF_K=60
# OUTLAWZ_VECTOR_WEIGHT=1.0
# OUTLAWZ_KEYWORD_WEIGHT=1.0

# ---------------------------------------------------------------- chat
# Earlier messages used to understand a follow-up question (0 turns this off).
# OUTLAWZ_HISTORY_MESSAGES=6
# Token budget for the passages in each prompt.
# OUTLAWZ_CONTEXT_TOKENS=3200
# Use saved preferences ("answer in bullet points") as style guidance.
# OUTLAWZ_PREFERENCES=true

# ---------------------------------------------------------------- logs, backups, clean-up
# Logs hold numbers and ids only: never document text, questions or answers.
# OUTLAWZ_LOG_DAYS=30
# OUTLAWZ_ACTIVITY_DAYS=365
# Share of normal traces kept; slow and failed ones are always kept.
# OUTLAWZ_TRACE_SAMPLE=0.1
# OUTLAWZ_SLOW_TRACE_MS=2000
# Scheduled backups: daily or off; how many to keep; whether to include the documents.
# OUTLAWZ_BACKUP_EVERY=daily
# OUTLAWZ_BACKUP_KEEP=7
# OUTLAWZ_BACKUP_DOCUMENTS=false
# Days before deleted documents leave the Trash, and before built exports are removed.
# OUTLAWZ_TRASH_DAYS=30
# OUTLAWZ_EXPORT_DAYS=7
# Ask pypi.org once a day whether a newer version exists. Off unless you turn it on.
# OUTLAWZ_UPDATE_CHECK=false
# Console log level: debug, info, warning or error.
# OUTLAWZ_LOG_LEVEL=info
